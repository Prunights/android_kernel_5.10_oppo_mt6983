 +	struct platform_device *pdev = to_platform_device(dev);
 +	int ret;
 +
 +	ret = driver_set_override(dev, (const char **)&pdev->driver_override, buf, count);
 +	if (ret)
 +		return ret;
 +
 +	return count;
 +}
 +
